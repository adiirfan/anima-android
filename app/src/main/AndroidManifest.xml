<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- the picture queue draws in the background with progress notifications (QueueService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the update check fetches latest.json through DownloadManager without a notification -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <application
        android:label="Anima"
        android:icon="@mipmap/ic_silver"
        android:roundIcon="@mipmap/ic_silver"
        android:networkSecurityConfig="@xml/network_security"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Qualcomm's neural-unit library is opened from the app's library folder. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <!-- Hands a downloaded app update to Android's installer (AppUpdate). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <service
            android:name=".QueueService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Draws queued pictures on the phone's AI chip" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The app's icon in the launcher: one entry per built-in icon, only one switched on at a time (AppIcon.kt,
             Settings > App icon), the way apps such as Reddit let you pick their icon. -->
        <activity-alias
            android:name=".IconSilver"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_silver"
            android:roundIcon="@mipmap/ic_silver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_pink"
            android:roundIcon="@mipmap/ic_pink"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlack"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_black"
            android:roundIcon="@mipmap/ic_black"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlonde"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_blonde"
            android:roundIcon="@mipmap/ic_blonde"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
